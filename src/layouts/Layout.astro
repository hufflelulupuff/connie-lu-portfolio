---
import '../styles/global.css';
import {site, url} from '../data/site';
interface Props { title?:string; description?:string; noindex?:boolean; }
const { title = 'SEO Writer & Content Strategist', description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const configured = import.meta.env.SITE_CONFIGURED;
const nav = [['work/', '作品'], ['about/', '關於我'], ['services/', '服務'], ['contact/', '合作洽詢']];
---
<!doctype html><html lang="zh-Hant"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} — Connie Lu.</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex || !configured ? 'noindex, follow' : 'index, follow'}/><meta property="og:title" content={`${title} — Connie Lu.`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="zh_TW"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(url('og.png'), Astro.site)}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/><meta name="theme-color" content="#F8F9FA"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Connie Lu',url:new URL(url(),Astro.site),jobTitle:'SEO Writer & Content Strategist'})}/></head><body>
<a class="skip" href="#main">跳至主要內容</a>
<header class="header wrap"><a class="wordmark" href={url()} aria-label="Connie Lu. 首頁">Connie Lu<span>.</span></a><button class="menu-toggle" aria-controls="navigation" aria-expanded="false">選單 <span aria-hidden="true">＋</span></button><nav id="navigation" aria-label="主選單">{nav.map(([path,label])=><a href={url(path)} class:list={{contact: path==='contact/'}} aria-current={Astro.url.pathname===url(path)?'page':undefined}>{label}{path==='contact/'&&<span aria-hidden="true"> ↗</span>}</a>)}</nav></header>
<main id="main"><slot/></main>
<footer class="wrap footer"><a class="wordmark" href={url()}>Connie Lu<span>.</span></a><p>有策略的文字，有溫度的溝通。</p><div><a href={`mailto:${site.email}`}>Email ↗</a><span>© {new Date().getFullYear()} Connie Lu.</span></div></footer>
<script>const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle'); const nav=document.querySelector<HTMLElement>('#navigation'); toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open)); nav?.classList.toggle('open',open);}); document.addEventListener('keydown',e=>{if(e.key==='Escape'){toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('open');toggle?.focus();}});</script>
</body></html>
