---
interface Props {text:string;}
const {text}=Astro.props;
type Block={kind:'p'|'h2'|'h3'|'ul'; text?:string; items?:string[]};
const blocks:Block[]=[];
for(const line of text.split(/\r?\n/).map(s=>s.trim()).filter(Boolean)){
  const bullet=line.match(/^(?:\*|•|✔️?)\s+(.*)$/u);
  if(bullet){const last=blocks.at(-1);if(last?.kind==='ul')last.items!.push(bullet[1]);else blocks.push({kind:'ul',items:[bullet[1]]});}
  else if(line.startsWith('### '))blocks.push({kind:'h3',text:line.slice(4)});
  else if(line.startsWith('## '))blocks.push({kind:'h2',text:line.slice(3)});
  else blocks.push({kind:'p',text:line});
}
const headings=blocks.flatMap((b,i)=>b.kind==='h2'?[{title:b.text,id:`article-section-${i}`}]:[]);
---
<div class="archive-layout">
  {headings.length>0&&<nav class="archive-toc" aria-label="文章目錄"><p class="eyebrow">IN THIS ARTICLE</p>{headings.map(h=><a href={`#${h.id}`}>{h.title}</a>)}</nav>}
  <div class="archive-prose">{blocks.map((b,i)=>b.kind==='ul'?<ul>{b.items!.map(item=><li>{item}</li>)}</ul>:b.kind==='h2'?<h2 id={`article-section-${i}`}>{b.text}</h2>:b.kind==='h3'?<h3>{b.text}</h3>:<p>{b.text}</p>)}</div>
</div>
