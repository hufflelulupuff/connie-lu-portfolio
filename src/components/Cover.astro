---
import {url} from '../data/site';
import type {Project} from '../data/projects';
interface Props {project:Project; wide?:boolean;}
const {project:p,wide=false}=Astro.props;
const category=p.category==='banquet'?'HOSPITALITY':p.category==='seasonal'?'FOOD & LIFESTYLE':p.slug.includes('honeymoon')?'TRAVEL & CULTURE':'WEDDING & STYLE';
const heading=p.coverHeading || p.title.split('\n')[0].replace(/[，。]$/,'');
---
<div class:list={['editorial-cover',{'editorial-cover-wide':wide}]}>
  <div class="editorial-photo">
    {p.coverImage ? <img src={url(p.coverImage)} alt={p.coverAlt || p.brand} loading="lazy" decoding="async" width="1200" height="960"/> : <div class="editorial-placeholder" aria-hidden="true"><span>CONTENT<br/>STUDIES.</span><i></i></div>}
    {p.coverNote && <span class="image-note">{p.coverNote}</span>}
  </div>
  <div class="editorial-caption" aria-hidden="true">
    <span class="editorial-number">{p.issue}<i></i></span>
    <p class="editorial-title">{heading.split('\n').map(line=><span>{line}</span>)}</p>
    <div class="editorial-caption-bottom"><span>{category}</span><span>{p.label.replace(' × ',' / ')}</span></div>
  </div>
</div>
