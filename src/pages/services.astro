---
import items from '../content/process.json';
import Layout from '../layouts/Layout.astro';import CTA from '../components/CTA.astro';
import services from '../content/service-items.json';

import copy from '../content/services.json';
---
<Layout title={copy.seoTitle}><section class="wrap page-head"><p class="eyebrow">{copy.text1}</p><h1>{copy.text2}<br/>{copy.text3}</h1><p class="lead">{copy.text4}</p></section><section class="wrap service-details">{services.map(s=><article><div><span class="number">{s.n}</span><p class="eyebrow">{s.en}</p><h2>{s.title}</h2><p>{s.desc}</p></div><div><p class="eyebrow">{copy.text5}</p><ul>{s.items.map(i=><li>{i}</li>)}</ul></div></article>)}</section><section class="wrap section"><p class="eyebrow">THE PROCESS</p><h2>{copy.text6}</h2><div class="four-columns">{items.map(({n,t,d})=><div><span class="number">{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></section><section class="wrap faq section"><p class="eyebrow">BEFORE WE START</p><h2>{copy.text7}</h2><details><summary>{copy.text8}</summary><p>{copy.text9}</p></details><details><summary>{copy.text10}</summary><p>{copy.text11}</p></details><details><summary>{copy.text12}</summary><p>{copy.text13}</p></details><details><summary>{copy.text14}</summary><p>{copy.text15}</p></details></section><CTA/></Layout>
