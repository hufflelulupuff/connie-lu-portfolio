---
import Layout from '../../layouts/Layout.astro';import Card from '../../components/Card.astro';import CTA from '../../components/CTA.astro';import {projects} from '../../data/projects';
---
<Layout title="精選作品｜旅宿餐飲 SEO 文章"><section class="wrap page-head"><p class="eyebrow">SELECTED WORK / 作品集</p><h1>有需求的地方，<br/>就有好內容的起點。</h1><p class="lead">旅宿、餐飲與生活情境，從搜尋意圖走進品牌故事。</p></section><section class="wrap section work-list"><div class="filters" role="group" aria-label="作品篩選" hidden><button data-filter="all" aria-pressed="true">全部作品 <small>04</small></button><button data-filter="banquet" aria-pressed="false">尾牙春酒</button><button data-filter="seasonal" aria-pressed="false">節慶餐飲</button><button data-filter="wedding" aria-pressed="false">好婚市集</button></div><p class="result-count" role="status" aria-live="polite">共 4 件案例</p><div class="project-grid">{projects.map(p=><Card project={p}/>)}</div><div class="empty-state" id="wedding-state" hidden><p class="eyebrow">WEDDING CONTENT / COMING NEXT</p><h2>好婚市集 SEO 作品區</h2><p>作品整理中。待補可驗證文章網址、作者署名或參與角色，以及可公開的展示內容。</p><p>目前尚無已核實的文章可供展示。</p></div><noscript><p>好婚市集作品整理中，待補可驗證文章資料。</p></noscript><p class="small-note">案例為原稿的結構與主題整理。封面為原創示意插畫，非品牌實景照片。</p></section><CTA/></Layout>
<script>const filters=document.querySelector<HTMLElement>('.filters'); if(filters)filters.hidden=false; const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]'); const cards=document.querySelectorAll<HTMLElement>('[data-category]'); buttons.forEach(button=>button.addEventListener('click',()=>{let count=0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));cards.forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.category!==button.dataset.filter;if(!card.hidden)count++;});const empty=document.querySelector<HTMLElement>('#wedding-state');if(empty)empty.hidden=button.dataset.filter!=='wedding';const status=document.querySelector('.result-count');if(status)status.textContent=`共 ${count} 件案例`; }));</script>
