---
import Layout from '../../layouts/Layout.astro';import Card from '../../components/Card.astro';import CTA from '../../components/CTA.astro';import {projects} from '../../data/projects';

import copy from '../../content/work.json';
---
<Layout title={copy.seoTitle}><section class="wrap page-head"><p class="eyebrow">{copy.text1}</p><h1>{copy.text2}<br/>{copy.text3}</h1><p class="lead">{copy.text4}</p></section><section class="wrap section work-list"><div class="filters" role="group" aria-label="作品篩選" hidden><button data-filter="all" aria-pressed="true">{copy.text5}<small>{String(projects.length).padStart(2,'0')}</small></button><button data-filter="banquet" aria-pressed="false">{copy.text6}</button><button data-filter="seasonal" aria-pressed="false">{copy.text7}</button><button data-filter="wedding" aria-pressed="false">{copy.text8}</button></div><p class="result-count" role="status" aria-live="polite">共 {projects.length} 件案例</p><div class="project-grid">{projects.map(p=><Card project={p}/>)}</div><div class="empty-state" id="wedding-state" hidden><p class="eyebrow">WEDDING CONTENT / COMING NEXT</p><h2>{copy.text10}</h2><p>{copy.text11}</p><p>{copy.text12}</p></div><noscript hidden={projects.some(p=>p.category==='wedding')}><p>{copy.text13}</p></noscript><p class="small-note">{copy.text14}</p></section><CTA/></Layout>
<script>const filters=document.querySelector<HTMLElement>('.filters'); if(filters)filters.hidden=false; const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]'); const cards=document.querySelectorAll<HTMLElement>('[data-category]'); buttons.forEach(button=>button.addEventListener('click',()=>{let count=0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));cards.forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.category!==button.dataset.filter;if(!card.hidden)count++;});const empty=document.querySelector<HTMLElement>('#wedding-state');if(empty)empty.hidden=button.dataset.filter!=='wedding'||count>0;const status=document.querySelector('.result-count');if(status)status.textContent=`共 ${count} 件案例`; }));</script>
