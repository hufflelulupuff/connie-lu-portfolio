---
import Layout from '../../../layouts/Layout.astro';
import ArticleText from '../../../components/ArticleText.astro';
import {projects,hasArchivedArticle} from '../../../data/projects';
import {url} from '../../../data/site';
export function getStaticPaths(){return projects.filter(hasArchivedArticle).map(p=>({params:{slug:p.slug},props:{p}}));}
const {p}=Astro.props;
---
<Layout title={`${p.articleTitle}｜作品文字版`} description={p.archiveSummary} noindex>
  <article class="wrap archive-article">
    <header class="page-head archive-head">
      <a class="back" href={url(`work/${p.slug}/`)}>← 返回案例介紹</a>
      <p class="eyebrow">WRITING ARCHIVE / 文章文字版</p>
      <h1>{p.articleTitle}</h1>
      <p class="archive-byline">Connie Lu. · {p.brand} · SEO 文章作品</p>
      <div class="archive-notice"><strong>活動已結束，文字留存</strong><p>{p.archiveSummary}</p></div>
    </header>
    <ArticleText text={p.articleBody!}/>
    <footer class="archive-end"><p>以上為原稿文字整理，保留當時的文章內容與活動資訊。</p><a class="text-link" href={url(`work/${p.slug}/`)}>返回案例介紹 ↗</a></footer>
  </article>
</Layout>
