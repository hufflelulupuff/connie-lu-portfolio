---
import Layout from '../../layouts/Layout.astro';import Cover from '../../components/Cover.astro';import CTA from '../../components/CTA.astro';import {projects} from '../../data/projects';import {url} from '../../data/site';
export function getStaticPaths(){return projects.map((p,index)=>({params:{slug:p.slug},props:{p,next:projects[(index+1)%projects.length]}}));}
const {p,next}=Astro.props;
---
<Layout title={`${p.brand}｜${p.label}案例`} description={p.intro}><section class="wrap page-head case-head"><a class="back" href={url('work/')}>← 返回所有作品</a><p class="eyebrow">CASE {p.issue} / {p.label}</p><h1>{p.title.split('\n').map(line=><span class="line">{line}</span>)}</h1><p class="lead">{p.brand} — SEO 內容案例</p></section><div class="wrap case-cover">{p.coverImage ? <img class="project-photo" src={url(p.coverImage)} alt={p.coverAlt || p.brand} loading="lazy" width="1200" height="960"/> : <Cover tone={p.color} issue={p.issue} brand={p.brand}/>}</div><section class="wrap case-body"><aside><p class="eyebrow">PROJECT NOTES</p><dl><dt>品牌</dt><dd>{p.brand}</dd><dt>內容類型</dt><dd>{p.category==='wedding'?'婚禮 SEO 文章':'旅宿餐飲 SEO 文章'}</dd><dt>讀者</dt><dd>{p.audience}</dd><dt>展示方式</dt><dd>自站案例介紹</dd></dl></aside><div class="prose"><section><p class="eyebrow">01 / CONTEXT</p><h2>從讀者的問題出發</h2><p>{p.intro}</p><div class="intent"><span>文章對應的搜尋主題</span><strong>{p.intent}</strong><small>依原稿內容歸納，非關鍵字搜尋量或排名報告。</small></div></section><section><p class="eyebrow">02 / STRUCTURE</p><h2>把資訊排成可閱讀的路徑</h2><ol class="structure">{p.structure.map((s,i)=><li><span>0{i+1}</span>{s}</li>)}</ol></section><section><p class="eyebrow">03 / CONTENT OBSERVATIONS</p><h2>這篇內容的溝通重點</h2>{p.focus.map(f=><p class="focus-point">{f}</p>)}<p class="small-note">以上為依使用者提供原稿所做的案例整理；個別專案的完整工作範圍待確認。本頁不提供成效數據或排名承諾。</p></section><section class="publication"><p class="eyebrow">04 / READ THE WORK</p><h2>文章與公開狀態</h2>{p.originalUrl ? <a class="text-link" href={p.originalUrl} target="_blank" rel="noopener noreferrer">閱讀原文 ↗</a> : <p>原文網址：待補可驗證的公開連結。</p>}{p.excerptApproved&&p.excerpt ? <blockquote>{p.excerpt}</blockquote> : <p>文章節錄：待確認公開授權後補上，目前僅展示案例介紹。</p>}<p class="small-note">本案為既有檔期作品，非現行餐飲活動公告。</p></section></div></section>{projects.length>1&&<nav class="wrap next-case" aria-label="下一個案例"><span class="eyebrow">NEXT CASE</span><a href={url(`work/${next.slug}/`)}>{next.brand} <span>↗</span></a></nav>}<CTA/></Layout>
