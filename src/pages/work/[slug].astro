---
import Layout from '../../layouts/Layout.astro';import Cover from '../../components/Cover.astro';import CTA from '../../components/CTA.astro';import {projects} from '../../data/projects';import {url} from '../../data/site';
export function getStaticPaths(){return projects.map((p,index)=>({params:{slug:p.slug},props:{p,next:projects[(index+1)%projects.length]}}));}
const {p,next}=Astro.props;
---
<Layout title={`${p.brand}｜${p.label}案例`} description={p.intro}><section class="wrap page-head case-head"><a class="back" href={url('work/')}>← 返回所有作品</a><p class="eyebrow">CASE {p.issue} / {p.label}</p><h1>{p.title.split('\n').map(line=><span class="line">{line}</span>)}</h1><p class="lead">{p.brand} — SEO 內容案例</p></section><div class="wrap case-cover"><Cover project={p} wide/></div><section class="wrap case-body"><aside><p class="eyebrow">PROJECT NOTES</p><dl><dt>品牌</dt><dd>{p.brand}</dd><dt>內容類型</dt><dd>{p.category==='wedding'?'婚禮 SEO 文章':'旅宿餐飲 SEO 文章'}</dd>{p.role&&<><dt>參與角色</dt><dd>{p.role}</dd></>}<dt>讀者</dt><dd>{p.audience}</dd><dt>展示方式</dt><dd>{p.originalUrl ? '案例介紹與公開原文連結' : '自站案例介紹'}</dd></dl></aside><div class="prose"><section><p class="eyebrow">01 / CONTEXT</p><h2>從讀者的問題出發</h2><p>{p.intro}</p><div class="intent"><span>文章對應的搜尋主題</span><strong>{p.intent}</strong><small>文章主題與搜尋用語整理，非搜尋量或排名數據。</small></div></section><section><p class="eyebrow">02 / STRUCTURE</p><h2>文章如何安排與展開</h2><ol class="structure">{p.structure.map((s,i)=><li><span>0{i+1}</span>{s}</li>)}</ol></section><section><p class="eyebrow">03 / CONTENT OBSERVATIONS</p><h2>這篇內容的溝通重點</h2>{p.focus.map(f=><p class="focus-point">{f}</p>)}<p class="small-note">{p.role ? '本頁整理文章的撰寫方向與內容架構；完整刊登版本請見下方原文。' : '本頁依原稿整理文章主題與架構，呈現內容規劃方式。'}</p></section><section class="publication"><p class="eyebrow">04 / READ THE WORK</p><h2>閱讀這篇作品</h2>{p.originalUrl ? <a class="text-link" href={p.originalUrl} target="_blank" rel="noopener noreferrer">閱讀原文 ↗</a> : <p>本頁提供案例介紹與文章架構。</p>}{p.excerptApproved&&p.excerpt ? <blockquote>{p.excerpt}</blockquote> : !p.originalUrl && <p>文章節錄待確認公開授權，目前以案例介紹呈現。</p>}<p class="small-note">{p.category==='wedding' ? '原文以平台編輯帳號刊登；此處標示 Connie 的撰寫角色，內容與更新日期以原刊登頁為準。' : '本案為既有檔期作品，非現行餐飲活動公告。'}</p></section></div></section>{projects.length>1&&<nav class="wrap next-case" aria-label="下一個案例"><span class="eyebrow">NEXT CASE</span><a href={url(`work/${next.slug}/`)}>{next.brand} <span>↗</span></a></nav>}<CTA/></Layout>
