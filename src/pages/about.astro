---
import Layout from '../layouts/Layout.astro';import CTA from '../components/CTA.astro';import {url} from '../data/site';

import copy from '../content/about.json';
---
<Layout title={copy.seoTitle}><section class="wrap page-head"><p class="eyebrow">{copy.text1}</p><h1>{copy.text2}<br/>{copy.text3}</h1></section><section class="wrap split about-content"><figure class="about-portrait">{copy.portrait&&<img src={url(copy.portrait)} alt={copy.portraitAlt} width="726" height="726" decoding="async"/>}<figcaption><span>CONNIE LU.</span><span>SEO WRITER & CONTENT STRATEGIST</span></figcaption></figure><div class="prose"><h2>{copy.text4}</h2><p class="large-copy">{copy.text5}</p><p>{copy.text6}</p><p>{copy.text7}</p><p>{copy.text8}</p><a class="text-link" href={url('work/')}>{copy.text9}</a></div></section><section class="wrap section"><p class="eyebrow">BEYOND WRITING</p><h2>{copy.text10}</h2><div class="three-columns"><div><span class="number">01</span><h3>{copy.text11}</h3><p>{copy.text12}</p></div><div><span class="number">02</span><h3>{copy.text13}</h3><p>{copy.text14}</p></div><div><span class="number">03</span><h3>{copy.text15}</h3><p>{copy.text16}</p><p class="small-note">{copy.text17}</p></div></div></section><CTA/></Layout>
