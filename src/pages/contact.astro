---
import Layout from '../layouts/Layout.astro';import {site} from '../data/site';
---
<Layout title="合作洽詢｜聊聊您的內容需求"><section class="wrap page-head"><p class="eyebrow">CONTACT / 合作洽詢</p><h1>您的下一篇內容，<br/>我們一起開始。</h1><p class="lead">不必先有完整企劃。從品牌、目標與一個想解決的問題開始就好。</p></section><section class="wrap contact-grid"><div><h2>直接寫信給我</h2><a class="email-link" href={`mailto:${site.email}`}>{site.email} ↗</a><p>合作費用依需求個別報價。</p><p class="small-note">填寫右側需求可產生郵件草稿；本站不接收或儲存表單資料。您仍需在郵件程式中確認並寄出。</p></div><form id="inquiry" data-email={site.email}><label for="name">稱呼／品牌名稱 <span>必填</span></label><input id="name" name="name" autocomplete="organization" required maxlength="100"/><label for="service">需要的協助</label><select id="service" name="service"><option>SEO 文章撰寫</option><option>網站與品牌內容</option><option>內容策略與優化</option><option>尚未確定，想先討論</option></select><label for="website">品牌或網站連結 <span>選填</span></label><input id="website" name="website" type="url" placeholder="https://" maxlength="500"/><label for="brief">簡單說說需求 <span>必填</span></label><textarea id="brief" name="brief" rows="5" required maxlength="1800" placeholder="目標讀者、內容主題、預計篇數、希望交付日期……"></textarea><button type="submit" class="button">產生 Email 草稿 <span>↗</span></button><p id="form-status" role="status" aria-live="polite"></p><div id="draft-panel" hidden><label for="draft">郵件草稿（可手動複製）</label><textarea id="draft" readonly rows="8"></textarea><a id="mail-draft" class="text-link" href={`mailto:${site.email}`}>用郵件程式開啟草稿 ↗</a></div><noscript><p>請直接點選左側信箱，將需求寄給 Connie。</p></noscript></form></section></Layout>
<script>const form=document.querySelector<HTMLFormElement>('#inquiry');form?.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(form);const subject=`合作洽詢｜${data.get('name')}｜${data.get('service')}`;const body=`Connie 您好，\n\n稱呼／品牌：${data.get('name')}\n合作類型：${data.get('service')}\n網站：${data.get('website')||'未提供'}\n\n需求說明：\n${data.get('brief')}\n\n謝謝！`;const panel=document.querySelector<HTMLElement>('#draft-panel');const draft=document.querySelector<HTMLTextAreaElement>('#draft');const link=document.querySelector<HTMLAnchorElement>('#mail-draft');if(panel)panel.hidden=false;if(draft)draft.value=`主旨：${subject}\n\n${body}`;if(link)link.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;const status=document.querySelector('#form-status');if(status)status.textContent='草稿已準備好，尚未寄出。請開啟郵件程式，或手動複製下方內容。';});</script>
