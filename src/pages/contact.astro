---
import Layout from '../layouts/Layout.astro';import {site} from '../data/site';

import copy from '../content/contact.json';
---
<Layout title={copy.seoTitle}><section class="wrap page-head"><p class="eyebrow">{copy.text1}</p><h1>{copy.text2}<br/>{copy.text3}</h1><p class="lead">{copy.text4}</p></section><section class="wrap contact-grid"><div><h2>{copy.text5}</h2><a class="email-link" href={`mailto:${site.email}`}>{site.email} ↗</a><p>{copy.text6}</p><p class="small-note">{copy.text7}</p></div><form id="inquiry" data-email={site.email}><label for="name">{copy.text8}<span>必填</span></label><input id="name" name="name" autocomplete="organization" required maxlength="100"/><label for="service">{copy.text9}</label><select id="service" name="service"><option>{copy.text10}</option><option>{copy.text11}</option><option>{copy.text12}</option><option>{copy.text13}</option></select><label for="website">{copy.text14}<span>選填</span></label><input id="website" name="website" type="url" placeholder="https://" maxlength="500"/><label for="brief">{copy.text15}<span>必填</span></label><textarea id="brief" name="brief" rows="5" required maxlength="1800" placeholder="目標讀者、內容主題、預計篇數、希望交付日期……"></textarea><button type="submit" class="button">{copy.text16}<span>↗</span></button><p id="form-status" role="status" aria-live="polite"></p><div id="draft-panel" hidden><label for="draft">{copy.text17}</label><textarea id="draft" readonly rows="8"></textarea><a id="mail-draft" class="text-link" href={`mailto:${site.email}`}>{copy.text18}</a></div><noscript><p>{copy.text19}</p></noscript></form></section></Layout>
<script>const form=document.querySelector<HTMLFormElement>('#inquiry');form?.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(form);const subject=`合作洽詢｜${data.get('name')}｜${data.get('service')}`;const body=`Connie 您好，\n\n稱呼／品牌：${data.get('name')}\n合作類型：${data.get('service')}\n網站：${data.get('website')||'未提供'}\n\n需求說明：\n${data.get('brief')}\n\n謝謝！`;const panel=document.querySelector<HTMLElement>('#draft-panel');const draft=document.querySelector<HTMLTextAreaElement>('#draft');const link=document.querySelector<HTMLAnchorElement>('#mail-draft');if(panel)panel.hidden=false;if(draft)draft.value=`主旨：${subject}\n\n${body}`;if(link)link.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;const status=document.querySelector('#form-status');if(status)status.textContent='草稿已準備好，尚未寄出。請開啟郵件程式，或手動複製下方內容。';});</script>
