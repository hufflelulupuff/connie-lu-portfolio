---
import items from '../content/home-services.json';
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import CTA from '../components/CTA.astro';import {projects} from '../data/projects';import {url} from '../data/site';

import copy from '../content/home.json';
---
<Layout><section class="hero wrap"><div class="hero-top"><p class="eyebrow"><span class="dot"></span> SEO WRITER & CONTENT STRATEGIST</p><span class="tiny">WORDS WITH PURPOSE.</span></div><h1>{copy.text1}<br/>{copy.headlinePrefix}<span class="blue ink">{copy.text2}</span></h1><div class="hero-bottom"><p>{copy.text3}<br class="desktop"/>{copy.text4}</p><a class="button" href={url('work/')}>{copy.text5}<span>↘</span></a></div><div class="hero-index"><span>{copy.text6}</span><span>{copy.text7}</span><span>{copy.text8}</span><span class="right">SCROLL TO EXPLORE ↓</span></div></section>
<section class="wrap section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>{copy.text9}</h2></div><a class="text-link" href={url('work/')}>{copy.text10}</a></div><div class="project-grid">{projects.slice(0,2).map(p=><Card project={p}/>)}</div><div class="editor-note"><span>THE EDITORIAL APPROACH</span><p>{copy.text11}<br/>{copy.text12}</p></div><div class="project-grid">{projects.slice(2).map(p=><Card project={p}/>)}</div></section>
<section class="about-strip"><div class="wrap split"><div><p class="eyebrow">02 / A LITTLE ABOUT ME</p><h2>{copy.text13}<br/>{copy.text14}</h2><a class="text-link" href={url('about/')}>{copy.text15}</a></div><div><p class="large-copy">{copy.text16}</p><p>{copy.text17}</p><div class="skill-line">SEARCH INTENT <span>／</span> BRAND VOICE <span>／</span> CONTENT STRUCTURE</div></div></div></section>
<section class="wrap section"><p class="eyebrow">03 / HOW I CAN HELP</p><h2>{copy.text18}</h2><div class="service-rows">{items.map(({n,t,d})=><a href={url('services/')}><span>{n}</span><h3>{t}</h3><p>{d}</p><b aria-hidden="true">↗</b></a>)}</div></section><CTA/></Layout>
